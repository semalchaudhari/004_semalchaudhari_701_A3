<!DOCTYPE html>

<html>

<head>
    <title>User Registration</title>
</head>

<body>

<h1 style="text-align: center;">User Registration</h1>

<% if (errors && errors.length > 0) { %>

    <table border="1" cellpadding="8" cellspacing="0" align="center">
        <tr>
            <th style="color: red;">Errors</th>
        </tr>

        <% errors.forEach(error => { %>
            <tr>
                <td style="color: red;">
                    <%= error.msg %>
                </td>
            </tr>
        <% }) %>
    </table>

    <br>

<% } %>


<form
    action="/register"
    method="POST"
    enctype="multipart/form-data"
>

    <table border="1" cellpadding="8" cellspacing="0" align="center">

        <!-- Username -->
        <tr>
            <td><b>Username</b></td>
            <td>
                <input
                    type="text"
                    name="username"
                    value="<%= oldData.username || '' %>"
                >
            </td>
        </tr>


        <!-- Password -->
        <tr>
            <td><b>Password</b></td>
            <td>
                <input
                    type="password"
                    name="password"
                >
            </td>
        </tr>


        <!-- Confirm Password -->
        <tr>
            <td><b>Confirm Password</b></td>
            <td>
                <input
                    type="password"
                    name="confirmPassword"
                >
            </td>
        </tr>


        <!-- Email -->
        <tr>
            <td><b>Email</b></td>
            <td>
                <input
                    type="email"
                    name="email"
                    value="<%= oldData.email || '' %>"
                >
            </td>
        </tr>


        <!-- Gender -->
        <tr>
            <td><b>Gender</b></td>
            <td>

                <input
                    type="radio"
                    name="gender"
                    value="male"
                    <%= oldData.gender === 'male' ? 'checked' : '' %>
                >
                Male

                <br>

                <input
                    type="radio"
                    name="gender"
                    value="female"
                    <%= oldData.gender === 'female' ? 'checked' : '' %>
                >
                Female

                <br>

                <input
                    type="radio"
                    name="gender"
                    value="other"
                    <%= oldData.gender === 'other' ? 'checked' : '' %>
                >
                Other

            </td>
        </tr>


        <!-- Hobbies -->
        <tr>
            <td><b>Hobbies</b></td>
            <td>

                <input
                    type="checkbox"
                    name="hobbies"
                    value="coding"
                    <%= Array.isArray(oldData.hobbies) &&
                        oldData.hobbies.includes('coding')
                        ? 'checked'
                        : ''
                    %>
                >
                Coding

                <br>

                <input
                    type="checkbox"
                    name="hobbies"
                    value="reading"
                    <%= Array.isArray(oldData.hobbies) &&
                        oldData.hobbies.includes('reading')
                        ? 'checked'
                        : ''
                    %>
                >
                Reading

                <br>

                <input
                    type="checkbox"
                    name="hobbies"
                    value="sports"
                    <%= Array.isArray(oldData.hobbies) &&
                        oldData.hobbies.includes('sports')
                        ? 'checked'
                        : ''
                    %>
                >
                Sports

                <br>

                <input
                    type="checkbox"
                    name="hobbies"
                    value="music"
                    <%= Array.isArray(oldData.hobbies) &&
                        oldData.hobbies.includes('music')
                        ? 'checked'
                        : ''
                    %>
                >
                Music

            </td>
        </tr>


        <!-- Profile Picture -->
        <tr>
            <td><b>Profile Picture</b></td>
            <td>
                <input
                    type="file"
                    name="profilePic"
                    accept="image/*"
                >
            </td>
        </tr>


        <!-- Other Pictures -->
        <tr>
            <td><b>Other Pictures</b></td>
            <td>
                <input
                    type="file"
                    name="otherPics"
                    multiple
                    accept="image/*"
                >
            </td>
        </tr>


        <!-- Submit -->
        <tr>
            <td colspan="2" align="center">

                <button
                    type="submit"
                    style="padding: 6px 15px;"
                >
                    Register
                </button>

            </td>
        </tr>

    </table>

</form>


</body>

</html>
